<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo scuro con una lieve inclinazione, non una bandiera. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/ic_launcher_ink"
                android:endColor="@color/ic_launcher_ink_deep" />
        </aapt:attr>
    </path>

    <!-- DeepSeek: alone in alto a sinistra, nucleo dentro la safe zone. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="33"
                android:gradientRadius="62"
                android:startColor="@color/ic_launcher_deepseek_glow"
                android:endColor="@color/ic_launcher_deepseek_fade" />
        </aapt:attr>
    </path>

    <!-- Claude: terracotta a destra, sovrapposta al blu senza tagli netti. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="76"
                android:centerY="46"
                android:gradientRadius="58"
                android:startColor="@color/ic_launcher_claude_glow"
                android:endColor="@color/ic_launcher_claude_fade" />
        </aapt:attr>
    </path>

    <!-- OpenAI: verde in basso, chiude la composizione a triangolo. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44"
                android:centerY="78"
                android:gradientRadius="62"
                android:startColor="@color/ic_launcher_openai_glow"
                android:endColor="@color/ic_launcher_openai_fade" />
        </aapt:attr>
    </path>

    <!-- Luce diagonale appena percettibile, per non lasciare il fondo piatto. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="76"
                android:endY="86"
                android:startColor="@color/ic_launcher_sheen"
                android:endColor="@color/ic_launcher_sheen_fade" />
        </aapt:attr>
    </path>
</vector>
