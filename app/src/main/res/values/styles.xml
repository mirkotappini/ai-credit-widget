<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tipografia -->
    <style name="TextAppearance.Ds.Balance" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">48sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Ds.DisplayS" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_sans_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ds_color_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_sans_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/ds_color_text_tertiary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ds_color_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Ds.MetricM" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.CaptionSmall" parent="TextAppearance.Ds.Caption">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Ds.MonoM" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_mono_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.MonoS" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_mono_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_color_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.MonoXS" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_mono_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/ds_color_text_tertiary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Ds.Segment" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plex_sans_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Pulsanti -->
    <style name="Widget.Ds.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_color_on_accent</item>
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/ds_color_accent</item>
        <item name="cornerRadius">@dimen/ds_radius_control</item>
        <item name="rippleColor">@color/ds_color_ripple</item>
        <item name="iconTint">@color/ds_color_on_accent</item>
    </style>

    <style name="Widget.Ds.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_color_text_primary</item>
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/ds_color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ds_radius_control</item>
        <item name="rippleColor">@color/ds_color_ripple</item>
        <item name="iconTint">@color/ds_color_text_primary</item>
    </style>

    <style name="Widget.Ds.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_color_accent</item>
        <item name="android:fontFamily">@font/plex_sans_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/ds_radius_control</item>
        <item name="rippleColor">@color/ds_color_ripple</item>
        <item name="iconTint">@color/ds_color_accent</item>
    </style>

    <style name="Widget.Ds.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ds_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_segment_text</item>
        <item name="android:fontFamily">@font/plex_sans_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/ds_segment_bg</item>
        <item name="strokeColor">@color/ds_segment_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/ds_radius_control</item>
        <item name="rippleColor">@color/ds_color_ripple</item>
    </style>

    <!-- Card -->
    <style name="Widget.Ds.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ds_color_surface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ds_color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="rippleColor">@color/ds_color_ripple</item>
    </style>

    <style name="Widget.Ds.Card.Hero" parent="Widget.Ds.Card">
        <item name="cardCornerRadius">@dimen/ds_radius_hero</item>
    </style>
</resources>
