<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_20"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_20"
        android:paddingBottom="@dimen/ds_space_32">

        <include
            layout="@layout/view_provider_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_provider_height" />

        <TextView
            android:id="@+id/provider_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.Ds.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/deepseek_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_section_access"
            android:textAppearance="@style/TextAppearance.Ds.Overline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/api_key_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_api_key_hint"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/ds_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/ds_color_text_secondary"
                    app:hintTextColor="@color/ds_color_text_tertiary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/api_key_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plex_mono_regular"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:saveEnabled="false"
                        android:textColor="@color/ds_color_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/api_key_helper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_api_key_helper_new"
                    android:textAppearance="@style/TextAppearance.Ds.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    style="@style/Widget.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_save_key" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/test_button"
                    style="@style/Widget.Ds.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_test"
                    app:icon="@drawable/ic_sync"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/ds_color_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/remove_key_button"
                    style="@style/Widget.Ds.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_remove_key"
                    android:textColor="@color/ds_color_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/settings_status_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/settings_status_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/dot_positive" />

                    <TextView
                        android:id="@+id/settings_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        tools:text="Connessione riuscita. Saldo $21,40." />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_section_alerts"
            android:textAppearance="@style/TextAppearance.Ds.Overline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_threshold_title"
                        android:textAppearance="@style/TextAppearance.Ds.CardTitle" />

                    <TextView
                        android:id="@+id/threshold_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Ds.MonoM" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/threshold_slider"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:stepSize="1"
                    android:value="10"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/ds_color_ripple"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/ds_color_accent"
                    app:trackColorActive="@color/ds_color_accent"
                    app:trackColorInactive="@color/ds_color_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_slider_min"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_slider_max"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_threshold_helper"
                    android:textAppearance="@style/TextAppearance.Ds.Caption" />

                <TextView
                    android:id="@+id/threshold_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_threshold_below"
                    android:textAppearance="@style/TextAppearance.Ds.Caption"
                    android:textColor="@color/ds_color_warning"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/notification_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_off"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        android:textColor="@color/ds_color_warning" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notifications_button"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_notifications_open" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/openai_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_section_admin_key"
                android:textAppearance="@style/TextAppearance.Ds.Overline" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/openai_key_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_openai_key_hint"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/ds_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/ds_color_text_secondary"
                        app:hintTextColor="@color/ds_color_text_tertiary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/openai_key_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plex_mono_regular"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:saveEnabled="false"
                            android:textColor="@color/ds_color_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/openai_key_helper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="3"
                        android:text="@string/settings_openai_key_helper_new"
                        android:textAppearance="@style/TextAppearance.Ds.Caption" />

                    <TextView
                        android:id="@+id/openai_key_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="2"
                        android:text="@string/settings_openai_key_warning"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        android:textColor="@color/ds_color_warning"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_save_button"
                        style="@style/Widget.Ds.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_openai_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_test_button"
                        style="@style/Widget.Ds.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_test"
                        app:icon="@drawable/ic_sync"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/ds_color_text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_remove_button"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_openai_remove"
                        android:textColor="@color/ds_color_error"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/openai_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/openai_status_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/dot_positive" />

                        <TextView
                            android:id="@+id/openai_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Ds.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/openai_credit_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/settings_openai_credit_section"
                android:textAppearance="@style/TextAppearance.Ds.Overline" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/openai_credit_amount_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/settings_openai_credit_amount_hint"
                        android:minHeight="@dimen/ds_input_height"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/ds_input_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/ds_color_text_tertiary"
                        app:prefixText="$"
                        app:prefixTextColor="@color/ds_color_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/openai_credit_amount_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plex_mono_regular"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLength="12"
                            android:maxLines="1"
                            android:saveEnabled="false"
                            android:textColor="@color/ds_color_text_primary"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/openai_credit_date_row"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:text="@string/settings_openai_credit_date"
                            android:textAppearance="@style/TextAppearance.Ds.Label" />

                        <TextView
                            android:id="@+id/openai_credit_date_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.Ds.MonoS"
                            android:textColor="@color/ds_color_text_primary" />

                        <ImageView
                            android:layout_width="@dimen/ds_icon_small"
                            android:layout_height="@dimen/ds_icon_small"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/ds_color_text_tertiary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/openai_credit_helper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="3"
                        android:text="@string/settings_openai_credit_helper"
                        android:textAppearance="@style/TextAppearance.Ds.Caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_credit_save_button"
                        style="@style/Widget.Ds.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="@string/settings_openai_credit_save" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_credit_remove_button"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings_openai_credit_remove"
                        android:textColor="@color/ds_color_error"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/openai_credit_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/openai_credit_status_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/dot_positive" />

                        <TextView
                            android:id="@+id/openai_credit_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/openai_credit_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:text="@string/settings_openai_credit_note"
                        android:textAppearance="@style/TextAppearance.Ds.CaptionSmall" />

                    <TextView
                        android:id="@+id/openai_credit_real_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="@style/TextAppearance.Ds.Caption"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/settings_openai_section_costs"
                android:textAppearance="@style/TextAppearance.Ds.Overline" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_openai_info_1"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_openai_info_2"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_openai_info_3"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_openai_info_4"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_openai_info_5"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_openai_info_6"
                        android:textAppearance="@style/TextAppearance.Ds.Body"
                        android:textColor="@color/ds_color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_section_refresh"
            android:textAppearance="@style/TextAppearance.Ds.Overline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_interval"
                    android:textAppearance="@style/TextAppearance.Ds.CardTitle" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/interval_group"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/interval_15"
                        style="@style/Widget.Ds.Button.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/settings_interval_15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/interval_30"
                        style="@style/Widget.Ds.Button.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_interval_30" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/interval_60"
                        style="@style/Widget.Ds.Button.Toggle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_interval_60" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_interval_helper_multi"
                    android:textAppearance="@style/TextAppearance.Ds.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_section_info"
            android:textAppearance="@style/TextAppearance.Ds.Overline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_version"
                        android:textAppearance="@style/TextAppearance.Ds.Label" />

                    <TextView
                        android:id="@+id/version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Ds.MonoS" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_color_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_privacy_multi"
                    android:textAppearance="@style/TextAppearance.Ds.Caption"
                    android:textColor="@color/ds_color_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
