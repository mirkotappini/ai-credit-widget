<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_space_20"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_space_20"
            android:paddingBottom="@dimen/ds_space_32">


            <include
                layout="@layout/view_provider_selector"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_provider_height"
                android:layout_marginBottom="12dp" />

            <!-- Skeleton del primo caricamento. -->
            <LinearLayout
                android:id="@+id/loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="72dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="140dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <!-- Stato vuoto o errore bloccante. -->
            <LinearLayout
                android:id="@+id/state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="64dp"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_8"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:id="@+id/state_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_key"
                    app:tint="@color/ds_color_text_secondary" />

                <TextView
                    android:id="@+id/state_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Ds.ScreenTitle" />

                <TextView
                    android:id="@+id/state_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Ds.Body"
                    android:textColor="@color/ds_color_text_secondary" />

                <TextView
                    android:id="@+id/state_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Ds.Caption"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/state_primary"
                    style="@style/Widget.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/state_secondary"
                    style="@style/Widget.Ds.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Contenuto con dati. -->
            <LinearLayout
                android:id="@+id/dashboard_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hero_card"
                    style="@style/Widget.Ds.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_20">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_balance_total"
                                android:textAppearance="@style/TextAppearance.Ds.Overline" />

                            <ImageView
                                android:id="@+id/status_dot"
                                android:layout_width="@dimen/ds_dot"
                                android:layout_height="@dimen/ds_dot"
                                android:contentDescription="@string/cd_status_fresh"
                                android:src="@drawable/dot_positive" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/balance_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="none"
                            android:fontFamily="@font/plex_mono_medium"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/value_unknown"
                            android:textColor="@color/ds_color_text_primary"
                            android:textSize="48sp"
                            app:autoSizeMaxTextSize="48sp"
                            app:autoSizeMinTextSize="28sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <TextView
                            android:id="@+id/updated_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dashboard_never_updated"
                            android:textAppearance="@style/TextAppearance.Ds.Caption" />

                        <com.patchouli.deepseekwidget.view.BalanceSplitView
                            android:id="@+id/split_view"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/dot_accent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_granted"
                                android:textAppearance="@style/TextAppearance.Ds.Label" />

                            <TextView
                                android:id="@+id/granted_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/value_unknown"
                                android:textAppearance="@style/TextAppearance.Ds.MonoM" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/dot_muted" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_topped"
                                android:textAppearance="@style/TextAppearance.Ds.Label" />

                            <TextView
                                android:id="@+id/topped_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/value_unknown"
                                android:textAppearance="@style/TextAppearance.Ds.MonoM" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/dashboard_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_banner_warning"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_14"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/banner_icon"
                        android:layout_width="@dimen/ds_icon_small"
                        android:layout_height="@dimen/ds_icon_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/ds_color_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/banner_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Ds.Label"
                            android:textColor="@color/ds_color_warning" />

                        <TextView
                            android:id="@+id/banner_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Ds.Caption"
                            android:textColor="@color/ds_color_text_secondary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/banner_action"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/state_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/today_card"
                    style="@style/Widget.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/ds_today_min_height">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_today_spent"
                                android:textAppearance="@style/TextAppearance.Ds.Overline" />

                            <TextView
                                android:id="@+id/today_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/value_unknown"
                                android:textAppearance="@style/TextAppearance.Ds.DisplayS" />

                            <TextView
                                android:id="@+id/today_caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="11sp"
                                android:textAppearance="@style/TextAppearance.Ds.Caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="68dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_seven_days"
                                android:textAppearance="@style/TextAppearance.Ds.Caption"
                                android:textSize="11sp" />

                            <com.patchouli.deepseekwidget.view.DailySpendChartView
                                android:id="@+id/today_bars"
                                android:layout_width="60dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_recent"
                        android:textAppearance="@style/TextAppearance.Ds.Overline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/see_all"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/dashboard_see_all" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/recent_card"
                    style="@style/Widget.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/recent_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/footer_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="@style/TextAppearance.Ds.Caption"
                    android:textSize="11sp" />
            </LinearLayout>
            
            <!-- Dashboard OpenAI: solo costi. -->
            <LinearLayout
                android:id="@+id/openai_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Ds.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_20">

                        <TextView
                            android:id="@+id/openai_day_label"
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:text="@string/openai_spent_today"
                            android:textAppearance="@style/TextAppearance.Ds.Overline" />

                        <TextView
                            android:id="@+id/openai_spent_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/plex_mono_medium"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/value_unknown"
                            android:textColor="@color/ds_color_text_primary"
                            android:textSize="48sp"
                            app:autoSizeMaxTextSize="48sp"
                            app:autoSizeMinTextSize="28sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/ds_latency_icon"
                                android:layout_height="@dimen/ds_latency_icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/ds_color_text_tertiary" />

                            <TextView
                                android:id="@+id/openai_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textAppearance="@style/TextAppearance.Ds.Caption"
                                android:textColor="@color/ds_color_text_tertiary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="2"
                            android:text="@string/openai_delay_note"
                            android:textAppearance="@style/TextAppearance.Ds.CaptionSmall"
                            android:textColor="@color/ds_color_text_tertiary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/ds_color_border" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/openai_seven_days"
                                    android:textAppearance="@style/TextAppearance.Ds.Overline" />

                                <TextView
                                    android:id="@+id/openai_week_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/value_unknown"
                                    android:textAppearance="@style/TextAppearance.Ds.MetricM" />

                                <TextView
                                    android:id="@+id/openai_week_caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="@style/TextAppearance.Ds.CaptionSmall"
                                    android:textColor="@color/ds_color_text_tertiary" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/ds_color_border" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/openai_current_month"
                                    android:textAppearance="@style/TextAppearance.Ds.Overline" />

                                <TextView
                                    android:id="@+id/openai_month_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/value_unknown"
                                    android:textAppearance="@style/TextAppearance.Ds.MetricM" />

                                <TextView
                                    android:id="@+id/openai_month_caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="@style/TextAppearance.Ds.CaptionSmall"
                                    android:textColor="@color/ds_color_text_tertiary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/openai_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_banner_warning"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_14"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:id="@+id/openai_banner_icon"
                        android:layout_width="@dimen/ds_icon_small"
                        android:layout_height="@dimen/ds_icon_small"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/ds_color_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/openai_banner_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Ds.Label"
                            android:textColor="@color/ds_color_warning" />

                        <TextView
                            android:id="@+id/openai_banner_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Ds.Caption"
                            android:textColor="@color/ds_color_text_secondary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openai_banner_action"
                        style="@style/Widget.Ds.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/openai_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/openai_daily_spend"
                                android:textAppearance="@style/TextAppearance.Ds.CardTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/openai_days_14"
                                android:textAppearance="@style/TextAppearance.Ds.Caption" />
                        </LinearLayout>

                        <com.patchouli.deepseekwidget.view.DailySpendChartView
                            android:id="@+id/openai_bars"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ds_bars_height"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="2"
                            android:text="@string/openai_bars_caption"
                            android:textAppearance="@style/TextAppearance.Ds.CaptionSmall"
                            android:textColor="@color/ds_color_text_tertiary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/openai_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="@style/TextAppearance.Ds.CaptionSmall"
                    android:textColor="@color/ds_color_text_tertiary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
